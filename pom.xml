<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>tech.kayys.wayang</groupId>
    <artifactId>wayang-parent</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <name>Wayang</name>
    <description>Low-code agentic factory, BPMN, EIP and DMN platform on top of Andalus (agents) and Gamelan (durable workflows)</description>
    <modules>
        <module>wayang-bom</module>
        <module>wayang-expression</module>
        <module>wayang-cel</module>
        <module>wayang-dmn</module>
        <module>wayang-business-process</module>
        <module>wayang-integration</module>
        <module>wayang-agent</module>
        <module>wayang-runtime</module>
        <module>wayang-embed</module>
        <module>wayang-connectors</module>
        <module>wayang-multimodal</module>
        <module>wayang-publish</module>
        <module>wayang-mcp</module>
        <module>wayang-store-jdbc</module>
        <module>wayang-api-core</module>
        <module>wayang-api-rest</module>
        <module>wayang-adapter-numu</module>
        <module>wayang-gamelan-worker</module>
        <module>wayang-adapter-gamelan</module>
        <module>wayang-examples</module>
    </modules>
    <profiles>
        <profile>
            <id>andalus</id>
            <modules><module>wayang-adapter-andalus</module></modules>
        </profile>
    </profiles>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <quarkus.platform.version>3.32.2</quarkus.platform.version>
        <gamelan.version>0.1.1</gamelan.version>
        <andalus.version>0.0.1</andalus.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <surefire.version>3.5.2</surefire.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration><release>${maven.compiler.release}</release><parameters>true</parameters></configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
