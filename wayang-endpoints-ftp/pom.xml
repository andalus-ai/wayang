<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.kayys.wayang</groupId>
        <artifactId>wayang-parent</artifactId>
        <version>0.0.1</version>
    </parent>
    <artifactId>wayang-endpoints-ftp</artifactId>
    <name>wayang-endpoints-ftp</name>
    <description>Optional extension: FTP/FTPS as connectors (ftp-list/read/write/delete) and a trigger source (ftp); needs commons-net</description>
    <properties>
        <commons-net.version>3.11.1</commons-net.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>tech.kayys.wayang</groupId>
            <artifactId>wayang-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- the only third-party library of this module (an FTP/FTPS client; the JDK has none); not managed by the Quarkus BOM, so pinned here -->
        <dependency>
            <groupId>commons-net</groupId>
            <artifactId>commons-net</artifactId>
            <version>${commons-net.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
