<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.kayys.wayang</groupId>
        <artifactId>wayang-parent</artifactId>
        <version>0.0.1</version>
    </parent>
    <artifactId>wayang-endpoints-amqp</artifactId>
    <name>wayang-endpoints-amqp</name>
    <description>Optional extension: RabbitMQ / AMQP 0-9-1 publishing (amqp-publish); needs amqp-client</description>
    <properties>
        <amqp-client.version>5.21.0</amqp-client.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>tech.kayys.wayang</groupId>
            <artifactId>wayang-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- the only third-party library of this module (a RabbitMQ AMQP 0-9-1 client; the JDK has none); not managed by the Quarkus BOM, so pinned here -->
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
            <version>${amqp-client.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
